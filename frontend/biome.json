{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["src/**"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noConsole": "warn",
                "noArrayIndexKey": "warn"
            },
            "a11y": {
                "noSvgWithoutTitle": "warn",
                "noStaticElementInteractions": "warn",
                "useKeyWithClickEvents": "warn"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "overrides": [
        {
            "includes": ["src/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useExhaustiveDependencies": "warn"
                    }
                }
            }
        }
    ]
}
