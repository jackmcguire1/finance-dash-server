PGHOST=localhost
PGPORT=5435
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=financedashdb
PORT=8080

# CoinGecko API key — optional for free tier, required for Pro
# Demo keys start with CG-, Pro keys do not
COINGECKO_API_KEY=xxx

# Firebase — must match VITE_FIREBASE_PROJECT_ID on the frontend
FIREBASE_PROJECT_ID=demo-finance-dash
# Points Admin SDK at the local emulator; remove in prod
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
