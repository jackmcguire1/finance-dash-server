# PostgreSQL connection — matches docker-compose defaults for local dev
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=financedashdb

# Fastify listen port
PORT=8080

# CoinGecko API key — optional for free tier, required for Pro
# Demo keys start with CG-, Pro keys do not
COINGECKO_API_KEY=
